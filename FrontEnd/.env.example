# URL de la API del BackEnd (Express + Supabase)
# Por defecto el frontend usa http://localhost:4000/api
VITE_API_URL=http://localhost:4000/api

# ===== Login público de clientes (#/acceder) =====
# Google: Client ID OAuth 2.0 tipo "Aplicación web" (console.cloud.google.com)
VITE_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Apple: Services ID (web) o Bundle ID (app) con "Sign In with Apple" activo
VITE_APPLE_CLIENT_ID=com.akcreaciones.web
