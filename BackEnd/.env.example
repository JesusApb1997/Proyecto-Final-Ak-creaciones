# ============================================================================
# BackEnd/.env.example — copia este archivo como ".env" y rellena los valores
# (el .env real NUNCA se sube al repositorio)
# ============================================================================

PORT=4000
NODE_ENV=development

# --- Base de datos (Supabase PostgreSQL) ---
DATABASE_URL=postgresql://postgres:TU_PASSWORD@db.TU-PROYECTO.supabase.co:5432/postgres

# --- Supabase Storage (bucket público "Imagenes") ---
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE=TU_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY=TU_ANON_KEY
SUPABASE_BUCKET=Imagenes

# --- CORS / JWT ---
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=cambia-esta-frase-secreta-larga

# --- OAuth social (login público de clientes) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google
APPLE_CLIENT_ID=
APPLE_BUNDLE_ID=

# ===========================================================================
# CORREO — facturas de pedidos + recuperación de contraseña (nodemailer)
#
# GMAIL SMTP (500 correos/día):
#   1. Activa la verificación en 2 pasos en tu cuenta de Google:
#      https://myaccount.google.com/security
#   2. Crea una "Contraseña de aplicación" (16 caracteres):
#      https://myaccount.google.com/apppasswords  (elige "Correo")
#   3. Pega aquí tu Gmail y la contraseña de 16 caracteres:
#
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tu-correo@gmail.com
# SMTP_PASS=abcd efgh ijkl mnop   <- la contraseña de aplicación (16 caracteres)
# MAIL_FROM=AK Creaciones <tu-correo@gmail.com>
#
# Sin estas variables, los correos NO se envían: se imprimen en la consola
# del backend y se guardan en BackEnd/.mail-out/ para poder probar el flujo.
# ===========================================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=AK Creaciones <no-reply@akcreaciones.com>

# URL del frontend (para los enlaces de los correos y el logo de la marca)
FRONT_URL=http://localhost:5173
MAIL_LOGO_URL=
