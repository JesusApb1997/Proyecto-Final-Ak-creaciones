{
  "name": "backend-proyecto-final-ak",
  "version": "1.0.0",
  "description": "API REST con Express + PostgreSQL (Supabase) para gestionar usuarios y roles",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "dev:kill": "node scripts/kill-port.js 4000 && nodemon src/server.js",
    "seed": "node src/scripts/seed.js",
    "seed:products": "node src/scripts/seed-products.js",
    "seed:auth": "node src/scripts/seed-auth.js",
    "fix:passwords": "node src/scripts/fix-passwords.js",
    "migrate:reset-tokens": "node src/scripts/migrate-reset-tokens.js",
    "migrate:customers": "node src/scripts/migrate-customers.js",
    "migrate:delivery": "node src/scripts/migrate-delivery.js",
    "migrate:payment-settings": "node src/scripts/migrate-payment-settings.js",
    "migrate:inventario": "node src/scripts/migrate-inventario.js",
    "seed:inventario": "node src/scripts/seed-inventario.js",
    "migrate:images": "node src/scripts/migrate-images.js",
    "gen:qr": "node src/scripts/generate-qr.js",
    "gen:diagram": "node scripts/generate-process-diagram.js",
    "gen:icons": "node src/scripts/generate-icons.js"
  },
  "keywords": [
    "express",
    "postgresql",
    "supabase",
    "api-rest"
  ],
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.15.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "nodemailer-stub-transport": "^1.1.0",
    "nodemon": "^3.1.11",
    "sharp": "^0.35.4"
  }
}
