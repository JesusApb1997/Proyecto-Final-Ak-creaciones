# Variables de entorno del BackEnd — login público de clientes
# Agrega estas líneas a tu archivo BackEnd/.env

# ============================================================
# GOOGLE SIGN-IN (obligatorio para el botón "Continuar con Google")
# ============================================================
# 1. Entra a https://console.cloud.google.com/apis/credentials
# 2. Crea un "ID de cliente de OAuth 2.0" → tipo "Aplicación web"
# 3. En "Orígenes autorizados de JavaScript" agrega:
#      http://localhost:5173  (y tu dominio de producción)
# 4. En "URIs de redirección autorizados" agrega:
#      http://localhost:5173/auth/google  (y tu dominio de producción)
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxx
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google

# ============================================================
# SIGN IN WITH APPLE (obligatorio para el botón "Continuar con Apple")
# ============================================================
# 1. En https://developer.apple.com/account → Certificates, IDs & Profiles
# 2. Crea un "Services ID" (web) o usa tu Bundle ID (app)
# 3. Activa "Sign In with Apple" y registra el dominio del frontend
APPLE_CLIENT_ID=com.akcreaciones.web
